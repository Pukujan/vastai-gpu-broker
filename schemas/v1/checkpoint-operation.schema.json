{
  "$id": "https://project-continuity.dev/schema/v1/checkpoint-operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "schema": {
      "const": "project-continuity.checkpoint-operation.v1"
    },
    "task_id": {
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "task_id",
    "request_id",
    "payload_sha256"
  ],
  "title": "Checkpoint operation identity v1",
  "type": "object"
}
